# Shared git config — machine-specific identity lives in ~/.gitconfig.local
# (created per machine, never tracked; see the restore checklist for the
# work/personal snippets).

[push]
	default = simple
[init]
	defaultBranch = main
[alias]
	stasha = stash --all
	bblame = blame -w -C -C -C
	co = checkout
[rerere]
	enabled = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[pull]
	rebase = true
[include]
	path = ~/.gitconfig.local
